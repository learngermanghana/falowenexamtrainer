rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid)).data.status == 'cancelled'
      );
    }

    function courseUser() {
      return signedIn() && request.auth.token.get('examOnly', false) != true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('staff', false) == true ||
        request.auth.token.get('role', '') in ['admin', 'staff', 'tutor'] ||
        request.auth.token.get('email', '') in ['moxflex@gmail.com', 'staff@falowen.app']
      );
    }

    function ownsResource() {
      return signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    function ownsIncoming() {
      return signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    function ownsStudentResource() {
      return signedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    function ownsStudentIncoming() {
      return signedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    function ownershipFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'studentId',
        'userId',
        'uid',
        'ownerUid'
      ]);
    }

    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isStaff();
      allow create, update, delete: if isOwner(userId);
    }

    match /writingProgress/{progressId} {
      allow create: if ownsIncoming();
      allow read: if ownsResource() || isStaff();
      allow update: if ownsResource() && ownsIncoming() && ownershipFieldsUnchanged();
      allow delete: if ownsResource();

      match /attempts/{attemptId} {
        allow create: if ownsIncoming();
        allow read: if ownsResource() || isStaff();
        allow update: if ownsResource() && ownsIncoming() && ownershipFieldsUnchanged();
        allow delete: if ownsResource();
      }
    }

    // Assignment submission persistence.
    // Students can save/retrieve their own drafts, submissions, and one-time submission locks.
    // Staff can read/write for support and grading workflows.
    match /submissionDrafts/{draftId} {
      allow create: if ownsStudentIncoming() || isStaff();
      allow read: if ownsStudentResource() || isStaff();
      allow update: if (ownsStudentResource() && ownsStudentIncoming() && ownershipFieldsUnchanged()) || isStaff();
      allow delete: if ownsStudentResource() || isStaff();
    }

    // Scores and marking decisions are server/staff-owned even on student submissions.
    function hasNoMarkingFields() {
      return !request.resource.data.keys().hasAny([
        'markingStatus', 'finalScore', 'aiFeedback', 'feedbackSentToStudent',
        'automaticMarking', 'resultUrl', 'markingUpdatedAt'
      ]);
    }
    function markingFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'markingStatus', 'finalScore', 'aiFeedback', 'feedbackSentToStudent',
        'automaticMarking', 'resultUrl', 'markingUpdatedAt'
      ]);
    }
    match /submissions/{submissionId} {
      allow create: if (ownsStudentIncoming() && hasNoMarkingFields()) || isStaff();
      allow read: if ownsStudentResource() || isStaff();
      allow update: if (ownsStudentResource() && ownsStudentIncoming() && ownershipFieldsUnchanged() && markingFieldsUnchanged()) || isStaff();
      allow delete: if isStaff();
    }

    match /submissionLocks/{lockId} {
      allow create: if ownsStudentIncoming() || isStaff();
      // The timed-assignment UI listens to a student's deterministic lock ID
      // before the first attempt exists. An absent document has no resource.data
      // for ownsStudentResource() to check; permit only this owner's missing lock.
      // Existing lock contents remain subject to the ownership check below.
      allow get: if signedIn()
        && resource == null
        && lockId.matches('^timed__' + request.auth.uid.lower() + '__[a-z0-9._-]+$');
      allow read: if ownsStudentResource() || isStaff();
      allow update: if (ownsStudentResource() && ownsStudentIncoming() && ownershipFieldsUnchanged()) || isStaff();
      allow delete: if isStaff();
    }

    // Timed assignment attempts are one-use student records.
    // Students may create their own attempt and move it forward only.
    // Staff may delete an attempt to explicitly reset it.
    match /timedAssignmentAttempts/{attemptId} {
      allow create: if ownsStudentIncoming()
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds > 0
        && request.resource.data.durationSeconds <= 7200;

      // A missing first attempt has no owner fields: allow only own ID.
      allow get: if signedIn()
        && resource == null
        && attemptId.matches('^timed__' + request.auth.uid.lower() + '__[a-z0-9._-]+');
      allow read: if ownsStudentResource() || isStaff();

      allow update: if isStaff() || (
        ownsStudentResource()
        && ownsStudentIncoming()
        && ownershipFieldsUnchanged()
        && request.resource.data.assignmentKey == resource.data.assignmentKey
        && request.resource.data.level == resource.data.level
        && request.resource.data.durationSeconds == resource.data.durationSeconds
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.clientStartedAt == resource.data.clientStartedAt
        && (
          (resource.data.status == 'active' && request.resource.data.status in ['active', 'expired', 'submitted'])
          || (resource.data.status == 'expired' && request.resource.data.status in ['expired', 'submitted'])
          || (resource.data.status == 'submitted' && request.resource.data.status == 'submitted')
        )
      );

      allow delete: if isStaff();
    }

    // Shared, canonical A1-C1 course progress snapshot.
    // Students own their own snapshot; staff can read it for Admin/email/reporting.
    match /courseCompletionSnapshots/{snapshotId} {
      allow create: if ownsStudentIncoming() || isStaff();
      allow read: if ownsStudentResource() || isStaff();
      allow update: if (ownsStudentResource() && ownsStudentIncoming() && ownershipFieldsUnchanged()) || isStaff();
      allow delete: if ownsStudentResource() || isStaff();
    }

    match /writingReferences/{docId} {
      allow create: if ownsIncoming();
      allow read: if ownsResource() || isStaff();
      allow update: if ownsResource() && ownsIncoming() && ownershipFieldsUnchanged();
      allow delete: if ownsResource();
    }

    match /savedWriting/{docId} {
      allow create: if ownsIncoming();
      allow read: if ownsResource() || isStaff();
      allow update: if ownsResource() && ownsIncoming() && ownershipFieldsUnchanged();
      allow delete: if ownsResource();
    }

    match /writingFeedback/{docId} {
      allow create: if ownsIncoming();
      allow read: if ownsResource() || isStaff();
      allow update: if ownsResource() && ownsIncoming() && ownershipFieldsUnchanged();
      allow delete: if ownsResource();
    }

    // Live, ungraded classroom multiple-choice responses.
    // Signed-in users may read class responses. Students may only create/update
    // their own response document; staff may manage them for classroom support.
    match /classResponses/{responseId} {
      allow read: if signedIn();
      allow create: if ownsStudentIncoming() || isStaff();
      allow update: if (
        ownsStudentResource() &&
        ownsStudentIncoming() &&
        ownershipFieldsUnchanged()
      ) || isStaff();
      allow delete: if ownsStudentResource() || isStaff();
    }

    // Canonical live-class records are readable by signed-in students.
    // Only admins and tutors can change scheduling and communication records.
    match /classes/{document=**} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /classSessions/{document=**} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /zoomProfiles/{document=**} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /calendarFeeds/{document=**} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /auditLogs/{document=**} {
      allow read, write: if isStaff();
    }
    match /emailQueue/{document=**} {
      allow read, write: if isStaff();
    }

    // Existing Falowen collections that previously used the authenticated
    // fallback are listed explicitly so they cannot override private writing
    // and user-document rules.
    match /aiAuditLogs/{document=**} { allow read, write: if courseUser(); }
    match /announcements/{document=**} { allow read, write: if courseUser(); }
    match /archived/{document=**} { allow read, write: if courseUser(); }
    match /assignmentProgress/{document=**} { allow read, write: if courseUser(); }
    match /attendance/{document=**} { allow read, write: if courseUser(); }
    match /class_board/{document=**} { allow read, write: if courseUser(); }
    match /class_lesson_notes/{document=**} { allow read, write: if courseUser(); }
    match /grammarQuestions/{document=**} { allow read, write: if courseUser(); }
    match /group_discussion/{document=**} { allow read, write: if courseUser(); }
    match /language/{document=**} { allow read, write: if courseUser(); }
    match /leadCaptures/{document=**} { allow read, write: if courseUser(); }
    match /lessonProgress/{document=**} { allow read, write: if courseUser(); }
    match /loginSessions/{document=**} { allow read, write: if signedIn(); }
    match /notifications/{document=**} { allow read, write: if signedIn(); }
    match /paystackInitRequests/{document=**} { allow read, write: if courseUser(); }
    match /paystackWebhookEvents/{document=**} { allow read, write: if courseUser(); }
    match /presentationSessions/{document=**} { allow read, write: if courseUser(); }
    match /qa_posts/{document=**} { allow read, write: if courseUser(); }
    match /scores/{document=**} { allow read: if courseUser(); allow write: if isStaff(); }
    match /sessions/{document=**} { allow read, write: if courseUser(); }
    match /studentActivityEvents/{document=**} { allow read, write: if courseUser(); }
    match /studentNotifications/{document=**} { allow read, write: if courseUser(); }
    match /accountDeletionRequests/{uid} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }
    match /students/{studentId} {
      // Recovery may look up a missing UID document before querying the legacy
      // student-code profile. Only the root profile is readable while paused.
      allow read: if courseUser() || (request.auth != null && (studentId == request.auth.uid || resource.data.uid == request.auth.uid || resource.data.email == request.auth.token.email));
      allow create: if signedIn() && (isStaff() || (request.auth.token.get('examOnly', false) != true && !request.resource.data.keys().hasAny(['accountDeletionStatus', 'notificationsPausedForDeletion', 'systemDeletionTest', 'accountType'])));
      allow update: if signedIn() && (isStaff() || (
        (request.auth.token.get('examOnly', false) != true || resource.data.uid == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountDeletionStatus', 'notificationsPausedForDeletion', 'systemDeletionTest', 'accountType'])
        && (resource.data.get('accountType', '') != 'exam_only' || (
          resource.data.uid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'uid', 'studentCode', 'className', 'program', 'status', 'paymentStatus',
            'paid', 'balanceDue', 'tuitionFee', 'contractStart', 'contractEnd',
            'onboardingCompleted', 'trialStatus', 'trialStartedAt', 'trialEndsAt'
          ])
        ))
      ));
      allow delete: if isStaff() || (courseUser() && resource.data.uid == request.auth.uid && resource.data.get('accountType', '') != 'exam_only');
      match /{collectionId}/{documentId}/{nested=**} {
        allow read, write: if courseUser() || (signedIn() && studentId == request.auth.uid);
      }
    }
    // Goethe Speaking practice history is private to the signed-in learner.
    // No wildcard access: only the authenticated owner's progress may be read
    // or updated, regardless of the legacy student-code-based document ID.
    match /speakingProgress/{progressId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
    match /studyBuddyUsage/{document=**} { allow read, write: if courseUser(); }
    match /usageQuotas/{document=**} { allow read, write: if signedIn(); }
    match /writingScoreStats/{document=**} { allow read, write: if courseUser(); }
    match /writingSubmissions/{document=**} { allow read, write: if courseUser(); }


    // Admin and staff marking/dashboard access, including collection-group queries.
    // These grants do not change students' existing ownership permissions.
    match /{path=**}/submissions/{submissionId} {
      allow read, write: if isStaff();
    }
    match /{path=**}/posts/{postId} {
      allow read, write: if isStaff();
    }
    match /examTutorReviewQueue/{document=**} { allow read, write: if isStaff(); }
    match /ai_issue_reports/{document=**} { allow read, write: if isStaff(); }
    match /automaticScoreSync/{document=**} { allow read, write: if isStaff(); }
    match /markingJobs/{document=**} { allow read, write: if isStaff(); }
    // Generated AI marking drafts are private staff records, not student scores.
    // The Admin marking screen writes these before a teacher approves the result.
    match /markingResults/{document=**} { allow read, write: if isStaff(); }
    match /aiMarkingAudit/{document=**} { allow read, write: if isStaff(); }
    // Staff-only mock authoring records. Never grant student access or allow
    // a browser to mark a draft as a published full examination.
    match /mockFactoryDrafts/{draftId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.id == draftId
        && request.resource.data.level in ['A1','A2','B1','B2','C1','C2']
        && request.resource.data.status in ['draft','review'];
      allow update: if isStaff()
        && resource.data.id == draftId
        && request.resource.data.id == draftId
        && request.resource.data.level == resource.data.level
        && request.resource.data.status in ['draft','review'];
      allow delete: if false;
    }

    match /answerKeyRegistry/{document=**} { allow read, write: if isStaff(); }
    match /answerKeySyncRuns/{document=**} { allow read, write: if isStaff(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
