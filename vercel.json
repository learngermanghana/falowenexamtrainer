{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "installCommand": "npm install && npm --prefix functions install && npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "headers": [
    {
      "source": "/music/analytics-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/__falowen-build.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/__falowen-firebase-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/course-speaking-chat-cleanup.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/campus/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/exams/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/onboarding",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/payment-complete",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/login/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/signup/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/mock/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/music/catalog.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/music/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/chatgpt/connect",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/book/?",
      "status": 308,
      "headers": {
        "Location": "/books"
      }
    },
    {
      "src": "/robots\\.txt",
      "has": [
        {
          "type": "host",
          "value": "exams.falowen.app"
        }
      ],
      "dest": "/exams-robots.txt"
    },
    {
      "src": "/sitemap\\.xml",
      "has": [
        {
          "type": "host",
          "value": "exams.falowen.app"
        }
      ],
      "dest": "/exams-sitemap.xml"
    },
    {
      "src": "/robots\\.txt",
      "has": [
        {
          "type": "host",
          "value": "www.exams.falowen.app"
        }
      ],
      "dest": "/exams-robots.txt"
    },
    {
      "src": "/sitemap\\.xml",
      "has": [
        {
          "type": "host",
          "value": "www.exams.falowen.app"
        }
      ],
      "dest": "/exams-sitemap.xml"
    },
    {
      "src": "/german-a1-mock-test/?",
      "dest": "/german-a1-mock-test.html"
    },
    {
      "src": "/german-a2-mock-test/?",
      "dest": "/german-a2-mock-test.html"
    },
    {
      "src": "/a1-listening-practice/?",
      "dest": "/a1-listening-practice.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "exams.falowen.app"
        }
      ],
      "dest": "/exams-landing.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.exams.falowen.app"
        }
      ],
      "dest": "/exams-landing.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "music.falowen.app"
        }
      ],
      "dest": "/music/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/robots\\.txt",
      "has": [
        {
          "type": "host",
          "value": "music.falowen.app"
        }
      ],
      "dest": "/music/robots.txt"
    },
    {
      "src": "/",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "/goethe-a1-preparation/?",
      "dest": "/__seo/goethe-a1-preparation.html"
    },
    {
      "src": "/exam-practice/a1/?",
      "dest": "/__seo/exam-practice-a1.html"
    },
    {
      "src": "/goethe-a2-preparation/?",
      "dest": "/__seo/goethe-a2-preparation.html"
    },
    {
      "src": "/exam-practice/a2/?",
      "dest": "/__seo/exam-practice-a2.html"
    },
    {
      "src": "/goethe-b1-preparation/?",
      "dest": "/__seo/goethe-b1-preparation.html"
    },
    {
      "src": "/exam-practice/b1/?",
      "dest": "/__seo/exam-practice-b1.html"
    },
    {
      "src": "/goethe-b2-preparation/?",
      "dest": "/__seo/goethe-b2-preparation.html"
    },
    {
      "src": "/exam-practice/b2/?",
      "dest": "/__seo/exam-practice-b2.html"
    },
    {
      "src": "/goethe-c1-preparation/?",
      "dest": "/__seo/goethe-c1-preparation.html"
    },
    {
      "src": "/exam-practice/c1/?",
      "dest": "/__seo/exam-practice-c1.html"
    },
    {
      "src": "/goethe-c2-preparation/?",
      "dest": "/__seo/goethe-c2-preparation.html"
    },
    {
      "src": "/exam-practice/c2/?",
      "dest": "/__seo/exam-practice-c2.html"
    },
    {
      "src": "/courses/french-a1\\.html",
      "status": 307,
      "headers": {
        "Location": "/courses/",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "/signup/?",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "/login/?",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "/campus/(.*)",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "/help/?",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/help.html"
    },
    {
      "src": "/chatgpt/connect/?",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/classes/([^/]+)/?",
      "dest": "/classes/index.html"
    },
    {
      "src": "/api/public/classes",
      "dest": "/api/public-classes.js"
    },
    {
      "src": "/api/sync-student",
      "dest": "/api/sync-student.js"
    },
    {
      "src": "/api/placement-attempts",
      "dest": "/api/placement-attempts.js"
    },
    {
      "src": "/api/music-library",
      "dest": "/api/music-library.js"
    },
    {
      "src": "/api/music-lyrics",
      "dest": "/api/music-lyrics.js"
    },
    {
      "src": "/api/music",
      "dest": "/api/approved-music.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
