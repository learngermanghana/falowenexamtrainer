{
  "version": 2,
  "installCommand": "npm install && npm --prefix functions install && npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/build",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "routes": [
    { "src": "/signup/?", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/classes/([^/]+)/?", "dest": "/classes/index.html" },
    { "src": "/api/public/classes", "dest": "/api/public-classes.js" },
    { "src": "/api/sync-student", "dest": "/api/sync-student.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
